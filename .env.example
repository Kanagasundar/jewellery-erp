# demo = IndexedDB in-browser data (GitHub Pages friendly). production = REST API (CodeIgniter 4).
VITE_APP_MODE=demo
# Base URL of the production REST API, e.g. https://api.example.com/api/v1  (never put secrets here)
VITE_API_BASE_URL=
# Vite base path. "/" or empty = relative. For GitHub Pages project sites: /REPOSITORY-NAME/
VITE_BASE_PATH=/
